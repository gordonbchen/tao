# Optional. Tao runs without a .env file; sign in to Codex, Claude, or OpenCode from the header.

# Default models when a student has not picked one in the header.
CODEX_MODEL=gpt-6-luna
CLAUDE_MODEL=claude-sonnet-5
# OpenCode models are provider/model, from the providers OpenCode is signed in to.
# OPENCODE_MODEL=opencode-go/kimi-k3

# Reuse an existing host login directory instead of Tao's own Docker volume.
# This gives the sidecar access to those login files.
# CODEX_AUTH_DIR=/home/you/.codex
# CLAUDE_AUTH_DIR=/home/you/.claude
# OPENCODE_AUTH_DIR=/home/you/.local/share/opencode
