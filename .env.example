# For live OpenAI calls, supply a key in the study UI. Do not commit real API keys.

# Optional local model mode. Start Compose with --profile local-ai and pull
# a model into the ollama container first.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=your-downloaded-model

# Optional Codex CLI mode. Sign in with CODEX_HOME="$PWD/.codex-tao" codex login,
# then start Docker Compose with --profile local-codex.
# AI_PROVIDER=codex
# CODEX_AUTH_DIR=./.codex-tao
# CODEX_MODEL=your-available-codex-model
