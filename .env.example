# Enable one or both AI sidecars (comma-separated): local-codex, local-claude.
# Each sidecar calls hosted models through your own CLI login.
COMPOSE_PROFILES=local-codex

# Sign in with CODEX_HOME="$PWD/.codex-tao" codex login first.
CODEX_AUTH_DIR=./.codex-tao
CODEX_MODEL=gpt-6-luna

# Sign in with CLAUDE_CONFIG_DIR="$PWD/.claude-tao" claude auth login first.
CLAUDE_AUTH_DIR=./.claude-tao
CLAUDE_MODEL=claude-sonnet-5
