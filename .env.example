# Local-first provider configuration. Choose Codex or Ollama in the site header.

# Optional local model mode. Start Compose with --profile local-ai and pull
# a model into the ollama container first.
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=your-downloaded-model

# Optional Codex CLI mode. Sign in with CODEX_HOME="$PWD/.codex-tao" codex login,
# then start Docker Compose with --profile local-codex. Codex model selection in
# the header applies to new requests without restarting Docker.
# AI_PROVIDER=codex
# COMPOSE_PROFILES=local-codex
# CODEX_AUTH_DIR=./.codex-tao
# CODEX_MODEL=gpt-6-luna

# The optional OpenAI API key can be entered in site Settings. It stays in
# browser memory and is sent only with the current session's AI requests.
